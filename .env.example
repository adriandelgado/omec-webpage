# Public site URL used for canonical links and structured data.
SITE_URL="https://omec-mat.org"

# Local development defaults to the downloaded SQLite/libSQL database copy.
DATABASE_URL="file:./omec-webpage.db"
# DATABASE_URL="libsql://your-database-name.turso.io"

# Only set this for a remote Turso/libSQL database.
DATABASE_AUTH_TOKEN=""

# Cloudflare Turnstile
# 1x00000000000000000000AA (pass)
# 2x00000000000000000000AB (blocks)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
# 1x0000000000000000000000000000000AA (pass)
# 2x0000000000000000000000000000000AA (fails)
# 3x0000000000000000000000000000000AA (token spent)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Generate separate 32-byte random keys (64 lowercase hex characters).
# JSON: {"current":"v1","keys":{"v1":"<64 hex characters>"}}
# Keep previous versions while hashes/secrets still use them.
AUTH_PASSWORD_PEPPERS=
AUTH_TOTP_ENCRYPTION_KEYS=


# Used only by pnpm admin:bootstrap. Remove after the initial setup.
# Email: superadmin@example.org
# Name: Superadmin Demo
# Password: Prueba-segura-2026
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=

# MEDIA_BUCKET is a private R2 binding in wrangler.jsonc, not an environment string.
