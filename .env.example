# Public site URL used for canonical links and structured data.
SITE_URL="https://omec-mat.org"

# Local development defaults to the downloaded SQLite/libSQL database copy.
DATABASE_URL="file:./omec-webpage.db"

# Only set this for a remote Turso/libSQL database.
DATABASE_AUTH_TOKEN=""

# Production Cloudflare Worker secret/var examples:
# DATABASE_URL="libsql://your-database-name.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"
